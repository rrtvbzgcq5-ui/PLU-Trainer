<title>PLU-Lerner</title>

<style>
*{box-sizing:border-box}

body{
  margin:0;
  min-height:100vh;
  display:flex;
  align-items:center;
  justify-content:center;
  background:#fff;
  font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif
}

.trainer{
  width:min(520px,92vw);
  background:#174ea6;
  border-radius:24px;
  padding:30px 22px;
  text-align:center;
  color:#fff;
  transition:background .22s
}

.trainer.ok{background:#16803a}
.trainer.bad{background:#b42323}

.product{
  font-size:clamp(27px,7vw,39px);
  font-weight:750;
  line-height:1.15;
  margin:4px 0 28px
}

.answers{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:12px
}

button{
  border:0;
  border-radius:15px;
  min-height:64px;
  background:#3f7fe0;
  color:#fff;
  font-size:22px;
  font-weight:700;
  cursor:pointer
}

button:active{
  transform:scale(.97)
}

button:focus-visible{
  outline:3px solid #fff;
  outline-offset:3px
}

.trainer.ok button{
  background:#36b85a
}

.trainer.bad button{
  background:#e85b5b
}

.result{
  min-height:29px;
  margin-top:19px;
  font-size:20px;
  font-weight:750
}

@media(max-width:380px){
  .trainer{
    padding:23px 15px
  }

  button{
    font-size:19px
  }
}
</style>
</head>

